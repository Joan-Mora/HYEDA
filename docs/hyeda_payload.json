{"xml": "<?xml version=\"1.0\" encoding=\"utf-8\" ?>\n<!-- SQL XML - HYEDA - TCGS-F2-HYEDA-Aveiga -->\n<!-- Comentarios en espanol; tablas y campos en ingles -->\n<sql>\n<datatypes db=\"mysql\">\n  <group label=\"Numeric\" color=\"rgb(238,238,170)\">\n    <type label=\"Integer\" length=\"0\" sql=\"INTEGER\" quote=\"\"/>\n    <type label=\"BigInt\" length=\"0\" sql=\"BIGINT\" quote=\"\"/>\n    <type label=\"Decimal\" length=\"1\" sql=\"DECIMAL\" re=\"DEC\" quote=\"\"/>\n    <type label=\"Float\" length=\"0\" sql=\"FLOAT\" quote=\"\"/>\n    <type label=\"Double\" length=\"0\" sql=\"DOUBLE\" quote=\"\"/>\n    <type label=\"TinyInt\" length=\"0\" sql=\"TINYINT\" quote=\"\"/>\n  </group>\n  <group label=\"Character\" color=\"rgb(255,200,200)\">\n    <type label=\"Char\" length=\"1\" sql=\"CHAR\" quote=\"'\"/>\n    <type label=\"Varchar\" length=\"1\" sql=\"VARCHAR\" quote=\"'\"/>\n    <type label=\"Text\" length=\"0\" sql=\"TEXT\" quote=\"'\"/>\n  </group>\n  <group label=\"Date &amp; Time\" color=\"rgb(200,255,200)\">\n    <type label=\"Date\" length=\"0\" sql=\"DATE\" quote=\"'\"/>\n    <type label=\"Datetime\" length=\"0\" sql=\"DATETIME\" quote=\"'\"/>\n    <type label=\"Timestamp\" length=\"0\" sql=\"TIMESTAMP\" quote=\"'\"/>\n  </group>\n</datatypes>\n\n<!-- Clientes de la empresa -->\n<table x=\"40\" y=\"40\" name=\"customer\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"document\" null=\"0\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"name\" null=\"0\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"phone\" null=\"1\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"email\" null=\"1\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"address\" null=\"1\" autoincrement=\"0\">\n    <datatype>TEXT</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"id_copy_path\" null=\"1\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"data_consent\" null=\"0\" autoincrement=\"0\">\n    <datatype>TINYINT</datatype>\n    <default>0</default>\n  </row>\n  <row name=\"reputation_score\" null=\"1\" autoincrement=\"0\">\n    <datatype>DECIMAL</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"customer_type\" null=\"1\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"created_at\" null=\"1\" autoincrement=\"0\">\n    <datatype>TIMESTAMP</datatype>\n    <default>NULL</default>\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Clientes y datos de contacto</comment>\n</table>\n\n<!-- Consultas de antecedentes -->\n<table x=\"40\" y=\"340\" name=\"background_check\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"customer_id\" null=\"1\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"customer\" row=\"id\" />\n  </row>\n  <row name=\"document\" null=\"0\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"result\" null=\"1\" autoincrement=\"0\">\n    <datatype>TEXT</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"provider\" null=\"1\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"checked_at\" null=\"1\" autoincrement=\"0\">\n    <datatype>DATETIME</datatype>\n    <default>NULL</default>\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Consultas de antecedentes por cliente</comment>\n</table>\n\n<!-- Inventario de herramientas -->\n<table x=\"320\" y=\"40\" name=\"product\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"name\" null=\"0\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"description\" null=\"1\" autoincrement=\"0\">\n    <datatype>TEXT</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"daily_price\" null=\"0\" autoincrement=\"0\">\n    <datatype>DECIMAL</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"stock_total\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>0</default>\n  </row>\n  <row name=\"stock_available\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>0</default>\n  </row>\n  <row name=\"min_stock_threshold\" null=\"1\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"created_at\" null=\"1\" autoincrement=\"0\">\n    <datatype>TIMESTAMP</datatype>\n    <default>NULL</default>\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Inventario y precios diarios</comment>\n</table>\n\n<!-- Empleados del sistema -->\n<table x=\"40\" y=\"620\" name=\"user\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"username\" null=\"0\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"password_hash\" null=\"0\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"full_name\" null=\"1\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"email\" null=\"1\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"active\" null=\"0\" autoincrement=\"0\">\n    <datatype>TINYINT</datatype>\n    <default>1</default>\n  </row>\n  <row name=\"created_at\" null=\"1\" autoincrement=\"0\">\n    <datatype>TIMESTAMP</datatype>\n    <default>NULL</default>\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Empleados y administradores</comment>\n</table>\n\n<!-- Roles de acceso -->\n<table x=\"260\" y=\"620\" name=\"role\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"name\" null=\"0\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"description\" null=\"1\" autoincrement=\"0\">\n    <datatype>TEXT</datatype>\n    <default>NULL</default>\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Roles del sistema</comment>\n</table>\n\n<!-- Permisos por vista -->\n<table x=\"460\" y=\"620\" name=\"permission\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"code\" null=\"0\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"description\" null=\"1\" autoincrement=\"0\">\n    <datatype>TEXT</datatype>\n    <default>NULL</default>\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Permisos de acceso</comment>\n</table>\n\n<!-- Tabla intermedia usuario-rol N:M -->\n<table x=\"140\" y=\"860\" name=\"user_role\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"user_id\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"user\" row=\"id\" />\n  </row>\n  <row name=\"role_id\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"role\" row=\"id\" />\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Relacion N:M entre user y role</comment>\n</table>\n\n<!-- Tabla intermedia rol-permiso N:M -->\n<table x=\"360\" y=\"860\" name=\"role_permission\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"role_id\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"role\" row=\"id\" />\n  </row>\n  <row name=\"permission_id\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"permission\" row=\"id\" />\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Relacion N:M entre role y permission</comment>\n</table>\n\n<!-- Alquiler principal -->\n<table x=\"620\" y=\"200\" name=\"rental\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"customer_id\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"customer\" row=\"id\" />\n  </row>\n  <row name=\"user_id\" null=\"1\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"user\" row=\"id\" />\n  </row>\n  <row name=\"status\" null=\"0\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"start_date\" null=\"1\" autoincrement=\"0\">\n    <datatype>DATE</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"end_date\" null=\"1\" autoincrement=\"0\">\n    <datatype>DATE</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"actual_return_date\" null=\"1\" autoincrement=\"0\">\n    <datatype>DATE</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"delivery_address\" null=\"1\" autoincrement=\"0\">\n    <datatype>TEXT</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"delivery_lat\" null=\"1\" autoincrement=\"0\">\n    <datatype>DECIMAL</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"delivery_lng\" null=\"1\" autoincrement=\"0\">\n    <datatype>DECIMAL</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"hauling_enabled\" null=\"0\" autoincrement=\"0\">\n    <datatype>TINYINT</datatype>\n    <default>0</default>\n  </row>\n  <row name=\"hauling_cost\" null=\"1\" autoincrement=\"0\">\n    <datatype>DECIMAL</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"discount_amount\" null=\"1\" autoincrement=\"0\">\n    <datatype>DECIMAL</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"discount_reason\" null=\"1\" autoincrement=\"0\">\n    <datatype>TEXT</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"document_type\" null=\"1\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"total_amount\" null=\"1\" autoincrement=\"0\">\n    <datatype>DECIMAL</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"created_at\" null=\"1\" autoincrement=\"0\">\n    <datatype>TIMESTAMP</datatype>\n    <default>NULL</default>\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Alquileres con estado y ubicacion</comment>\n</table>\n\n<!-- Detalle N:M rental-product -->\n<table x=\"480\" y=\"480\" name=\"rental_item\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"rental_id\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"rental\" row=\"id\" />\n  </row>\n  <row name=\"product_id\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"product\" row=\"id\" />\n  </row>\n  <row name=\"quantity\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>1</default>\n  </row>\n  <row name=\"unit_price\" null=\"0\" autoincrement=\"0\">\n    <datatype>DECIMAL</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"estimated_days\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Detalle de productos en alquiler N:M</comment>\n</table>\n\n<!-- Reserva temporal de stock -->\n<table x=\"320\" y=\"340\" name=\"stock_reservation\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"product_id\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"product\" row=\"id\" />\n  </row>\n  <row name=\"rental_id\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"rental\" row=\"id\" />\n  </row>\n  <row name=\"quantity\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"expires_at\" null=\"1\" autoincrement=\"0\">\n    <datatype>DATETIME</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"created_at\" null=\"1\" autoincrement=\"0\">\n    <datatype>DATETIME</datatype>\n    <default>NULL</default>\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Reserva temporal de stock FIFO</comment>\n</table>\n\n<!-- Extension de tiempo de alquiler -->\n<table x=\"860\" y=\"480\" name=\"rental_extension\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"rental_id\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"rental\" row=\"id\" />\n  </row>\n  <row name=\"extra_days\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"requested_at\" null=\"1\" autoincrement=\"0\">\n    <datatype>DATETIME</datatype>\n    <default>NULL</default>\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Extensiones de tiempo del alquiler</comment>\n</table>\n\n<!-- Pagos y abonos -->\n<table x=\"920\" y=\"200\" name=\"payment\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"rental_id\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"rental\" row=\"id\" />\n  </row>\n  <row name=\"payment_type\" null=\"0\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"amount\" null=\"0\" autoincrement=\"0\">\n    <datatype>DECIMAL</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"status\" null=\"0\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"reference\" null=\"1\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"paid_at\" null=\"1\" autoincrement=\"0\">\n    <datatype>DATETIME</datatype>\n    <default>NULL</default>\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Pagos efectivo QR abonos y pendientes</comment>\n</table>\n\n<!-- Documentos PDF generados -->\n<table x=\"920\" y=\"40\" name=\"generated_document\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"rental_id\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"rental\" row=\"id\" />\n  </row>\n  <row name=\"document_type\" null=\"0\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"serial_number\" null=\"1\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"file_path\" null=\"1\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"generated_at\" null=\"1\" autoincrement=\"0\">\n    <datatype>DATETIME</datatype>\n    <default>NULL</default>\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Contratos remisiones devoluciones y facturas PDF</comment>\n</table>\n\n<!-- Devoluciones con incidencia -->\n<table x=\"620\" y=\"560\" name=\"return_incident\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"rental_id\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"rental\" row=\"id\" />\n  </row>\n  <row name=\"reason\" null=\"0\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"description\" null=\"1\" autoincrement=\"0\">\n    <datatype>TEXT</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"reported_at\" null=\"1\" autoincrement=\"0\">\n    <datatype>DATETIME</datatype>\n    <default>NULL</default>\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Devoluciones por dano o inconformidad</comment>\n</table>\n\n<!-- Deudas pendientes -->\n<table x=\"40\" y=\"480\" name=\"debt\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"customer_id\" null=\"0\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"customer\" row=\"id\" />\n  </row>\n  <row name=\"rental_id\" null=\"1\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"rental\" row=\"id\" />\n  </row>\n  <row name=\"balance\" null=\"0\" autoincrement=\"0\">\n    <datatype>DECIMAL</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"due_date\" null=\"1\" autoincrement=\"0\">\n    <datatype>DATE</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"overdue_days\" null=\"1\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"status\" null=\"0\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Deudas pendientes del cliente</comment>\n</table>\n\n<!-- Ingresos y gastos -->\n<table x=\"40\" y=\"1060\" name=\"financial_movement\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"movement_type\" null=\"0\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"amount\" null=\"0\" autoincrement=\"0\">\n    <datatype>DECIMAL</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"description\" null=\"1\" autoincrement=\"0\">\n    <datatype>TEXT</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"category\" null=\"1\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"movement_date\" null=\"0\" autoincrement=\"0\">\n    <datatype>DATE</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"user_id\" null=\"1\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"user\" row=\"id\" />\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Ingresos y gastos de la empresa</comment>\n</table>\n\n<!-- Cola de notificaciones WhatsApp -->\n<table x=\"620\" y=\"760\" name=\"notification\">\n  <row name=\"id\" null=\"0\" autoincrement=\"1\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"rental_id\" null=\"1\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"rental\" row=\"id\" />\n  </row>\n  <row name=\"customer_id\" null=\"1\" autoincrement=\"0\">\n    <datatype>INTEGER</datatype>\n    <default>NULL</default>\n    <relation table=\"customer\" row=\"id\" />\n  </row>\n  <row name=\"channel\" null=\"0\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"message\" null=\"1\" autoincrement=\"0\">\n    <datatype>TEXT</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"status\" null=\"0\" autoincrement=\"0\">\n    <datatype>VARCHAR</datatype>\n    <default>NULL</default>\n  </row>\n  <row name=\"sent_at\" null=\"1\" autoincrement=\"0\">\n    <datatype>DATETIME</datatype>\n    <default>NULL</default>\n  </row>\n  <key name=\"PRIMARY\" type=\"PRIMARY\">\n    <part>id</part>\n  </key>\n  <comment>Cola de notificaciones WhatsApp</comment>\n</table>\n\n</sql>\n"}